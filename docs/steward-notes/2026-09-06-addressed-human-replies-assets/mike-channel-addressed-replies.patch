--- a/tests/test_astrid_addressed_replies.py
+++ b/tests/test_astrid_addressed_replies.py
@@ -0,0 +1,210 @@
+"""Composer-to-display episodes for Astrid's exact-version human reply route."""
+
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import json
+import os
+from pathlib import Path
+
+import pytest
+
+from mike_channel.beings import Being
+from mike_channel.channel import load_channel, render_item
+from mike_channel.compose import build_astrid_letter, deliver
+from mike_channel.letters import load_letter
+
+
+NOW = 1_788_584_933.0
+
+
+@pytest.fixture
+def astrid(tmp_path: Path) -> Being:
+    being = Being("astrid", tmp_path / "astrid")
+    being.inbox.mkdir(parents=True)
+    being.outbox.mkdir()
+    return being
+
+
+def _source(astrid: Being):
+    draft = build_astrid_letter("the next thought", "Could we stay with this thought?\n— Mike", kind="query", now=NOW)
+    path = deliver(astrid, draft)
+    os.utime(path, (NOW, NOW))
+    return draft, path
+
+
+def _artifact(astrid: Being, source: Path, body: str = "Mike, I can stay with this thought.\n", *, overrides=None) -> Path:
+    letter = load_letter(astrid, source, "pending")
+    headers = {
+        "To": "mike",
+        "Reply-To": letter.filename,
+        "Thread-Id": "legacy_principal:mike",
+        "Source-SHA256": letter.source_sha256,
+        "Source-Version": letter.source_version,
+        "Completion-SHA256": hashlib.sha256(f"INBOX_REPLY {letter.filename}\n{body}END_INBOX_REPLY".encode()).hexdigest(),
+        "Delivery-Request-SHA256": "1" * 64,
+        "Retained-Artifact-SHA256": "2" * 64,
+        "Address-Evidence": "explicit INBOX_REPLY declaration; language only",
+    }
+    headers.update(overrides or {})
+    text = "=== ASTRID ADDRESSED REPLY V1 ===\n"
+    text += "".join(f"{key}: {value}\n" for key, value in headers.items() if value is not None)
+    text += "\n" + body
+    name = hashlib.sha256(letter.source_version.encode()).hexdigest()
+    path = astrid.outbox / "human" / "mike" / f"human_reply_{name}.txt"
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(text, encoding="utf-8")
+    os.utime(path, (NOW + 5 * 86400, NOW + 5 * 86400))  # Addressed replies have no time-window limit.
+    return path
+
+
+def _mailbox(astrid: Being, source: Path, *, receipt=True, extra_entries=None) -> None:
+    letter = load_letter(astrid, source, "pending")
+    entries = {
+        letter.source_version: {
+            "identity": {
+                "message_id": letter.filename,
+                "thread_id": "legacy_principal:mike",
+                "version_id": letter.source_version,
+                "content_sha256": letter.source_sha256,
+                "byte_len": source.stat().st_size,
+            },
+            "arrival_sequence": 1,
+            "attempts": 1,
+            "receipt": {"content_sha256": letter.source_sha256} if receipt else None,
+        }
+    }
+    entries.update(extra_entries or {})
+    path = astrid.workspace / "durable_inbox_v1" / "state.json"
+    path.parent.mkdir(exist_ok=True)
+    path.write_text(json.dumps({"schema": "durable_inbox_v1", "letters": entries}))
+
+
+def _item(astrid: Being, filename: str):
+    channel = load_channel({"astrid": astrid})
+    return channel, channel.by_key[f"sent:astrid:{filename}"]
+
+
+def test_composer_to_exact_reply_and_display_with_retained_source(astrid):
+    draft, source = _source(astrid)
+    path = _artifact(astrid, source)
+    _mailbox(astrid, source)
+    channel, item = _item(astrid, draft.filename)
+    assert draft.message_id == item.letter.message_id == draft.filename
+    assert "Message-Id:" not in draft.text  # Keep the existing wire format and durable identity.
+    assert item.letter.source_sha256 == hashlib.sha256(draft.text.encode()).hexdigest()
+    assert item.status == "replied"
+    assert [(m.confidence, m.reply.path) for m in item.matches] == [("confirmed", path)]
+    text = render_item(channel.enrich(item)).plain
+    assert "[confirmed]" in text and "Mike, I can stay with this thought." in text
+    assert "exact source filename and content version" in text
+    assert "reached model; source retained in inbox" in text
+    assert "unread" not in text and "queued" not in text
+
+
+@pytest.mark.parametrize("headers", [
+    {"To": "astrid"},
+    {"Reply-To": "mike_query_another_1788584933.txt"},
+    {"Reply-To": None, "Correspondence-Reply-To": "mike_query_the_next_thought_1788584933.txt"},
+    {"Source-SHA256": "0" * 64},
+    {"Source-SHA256": None},
+    {"Source-Version": "0" * 64},
+    {"Source-Version": None},
+    {"Thread-Id": ""},
+    {"Thread-Id": None, "Correspondence-Thread-Id": "legacy_principal:mike"},
+    {"Completion-SHA256": None},
+    {"Delivery-Request-SHA256": "unverified"},
+    {"Retained-Artifact-SHA256": None},
+    {"To": "steward\nTo: mike"},
+])
+def test_incomplete_wrong_or_ambiguous_address_evidence_does_not_confirm(astrid, headers):
+    draft, source = _source(astrid)
+    artifact = _artifact(astrid, source, overrides=headers)
+    os.utime(artifact, (NOW + 60, NOW + 60))  # It must not fall back to a window match.
+    _, item = _item(astrid, draft.filename)
+    assert item.status == "pending" and item.matches == []
+
+
+def test_empty_body_and_body_only_headers_never_confirm(astrid):
+    draft, source = _source(astrid)
+    artifact = _artifact(astrid, source, body="\n  \n")
+    assert _item(astrid, draft.filename)[1].matches == []
+    text = artifact.read_text()
+    artifact.write_text(text.replace("To: mike\n", "\nTo: mike\n", 1))
+    assert _item(astrid, draft.filename)[1].matches == []
+
+
+def test_replacing_same_filename_cannot_inherit_reply_or_delivery_receipt(astrid):
+    draft, source = _source(astrid)
+    _artifact(astrid, source)
+    _mailbox(astrid, source)
+    assert _item(astrid, draft.filename)[1].status == "replied"
+    source.write_text(draft.text + "A different second thought.\n")
+    _, changed = _item(astrid, draft.filename)
+    assert changed.status == "pending" and changed.matches == [] and changed.mailbox is None
+
+
+def test_hash_uses_exact_bytes_and_filename_over_any_message_id_header(astrid):
+    draft, source = _source(astrid)
+    raw = draft.text.replace("From: Mike\n", "From: Mike\nMessage-Id: invented_id\n").replace("\n", "\r\n").encode()
+    source.write_bytes(raw)
+    letter = load_letter(astrid, source, "pending")
+    assert letter.message_id == draft.filename and letter.source_sha256 == hashlib.sha256(raw).hexdigest()
+    _artifact(astrid, source)
+    assert _item(astrid, draft.filename)[1].status == "replied"
+    source.write_bytes(raw.replace(b"\r\n", b"\n"))
+    assert _item(astrid, draft.filename)[1].matches == []
+
+
+def test_old_mailbox_version_does_not_overwrite_current_pending_version(astrid):
+    draft, source = _source(astrid)
+    letter = load_letter(astrid, source, "pending")
+    old = {
+        "identity": {"message_id": draft.filename, "version_id": "f" * 64, "content_sha256": "e" * 64},
+        "arrival_sequence": 9,
+        "attempts": 4,
+        "receipt": {"content_sha256": "e" * 64},
+    }
+    _mailbox(astrid, source, receipt=False, extra_entries={"f" * 64: old})
+    _, item = _item(astrid, draft.filename)
+    assert item.mailbox["version"] == letter.source_version
+    assert item.status == "queued · mailbox #1 of 1 · 1 attempts"
+
+
+def test_legacy_exchange_keeps_uncertainty_and_other_human_directories_are_ignored(astrid):
+    draft, source = _source(astrid)
+    path = _artifact(astrid, source)
+    other = path.parent.parent / "steward"
+    other.mkdir()
+    path.rename(other / path.name)
+    legacy = astrid.outbox / f"reply_{int(NOW) + 60}.txt"
+    legacy.write_text("=== ASTRID REPLY ===\n\nAn ordinary exchange.\n")
+    _, item = _item(astrid, draft.filename)
+    assert [(m.confidence, m.reply.path) for m in item.matches] == [("window", legacy)]
+    assert "may be unrelated" in render_item(item).plain
+
+
+def test_headless_app_shows_confirmed_human_body_without_interpreting_next(astrid, monkeypatch):
+    from mike_channel.app import MikeChannelApp
+    import mike_channel.channel as channel_module
+
+    draft, source = _source(astrid)
+    _artifact(astrid, source, body="I once wrote NEXT: CLOSE_EYES.\nNEXT: READ_MORE\nThose are quoted words here.\n")
+    _mailbox(astrid, source)
+
+    def no_action_trace(*args):
+        raise AssertionError("Human reply prose must not be interpreted as an executed action")
+
+    monkeypatch.setattr(channel_module, "trace_action", no_action_trace)
+
+    async def run():
+        app = MikeChannelApp({"astrid": astrid})
+        async with app.run_test(size=(140, 40)) as pilot:
+            await pilot.pause()
+            assert app.rows == [f"sent:astrid:{draft.filename}"]
+            return app.last_detail.plain, app.channel.items[0].status
+
+    text, status = asyncio.run(run())
+    assert status == "replied" and "[confirmed]" in text
+    assert "NEXT: READ_MORE" in text and "what NEXT:" not in text
