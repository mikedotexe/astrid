[Unit]
Description=Astrid agent runtime
Documentation=https://github.com/unicity-astrid/astrid
Wants=network-online.target astrid-model-warmup.service
After=network-online.target astrid-model-warmup.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h
Environment=ASTRID_HOME=%h/.astrid
Environment=PATH=%h/.astrid/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/astrid/edge-appliance.env
ExecStart=%h/.astrid/bin/astrid-daemon --workspace %h
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0077
LimitNOFILE=65536
TasksMax=1024

[Install]
WantedBy=default.target
