# Measured AVADO profile: Intel i3-7167U, 2 cores / 4 threads, 16 GiB RAM.
# Qwen 3.5 4B Q4_K_M is the behaviorally strongest measured candidate.
ASTRID_EDGE_INSTANCE_NAME="AVADO Astrid"
TOKIO_WORKER_THREADS=4
ASTRID_EDGE_TELEMETRY_ADDR=127.0.0.1:7878
ASTRID_EDGE_SENSORY_ADDR=127.0.0.1:7879
ASTRID_EDGE_SOCKET=.astrid/run/system.sock
ASTRID_EDGE_TOKEN=.astrid/run/system.token
ASTRID_EDGE_WORKSPACE=.astrid/home/default/edge
ASTRID_EDGE_ASTRID_CLI=.astrid/bin/astrid
ASTRID_EDGE_FILL_TARGET=0.68
ASTRID_EDGE_TICK_HZ=20
ASTRID_EDGE_SPECTRAL_ENABLED=true
ASTRID_EDGE_SPECTRAL_ROLLUP_SECONDS=60
# Standing authority is always supplied by the separate owner-controlled
# authority file after observation acceptance.
ASTRID_EDGE_RESERVOIR_TUNING_ENABLED=false
ASTRID_EDGE_RESERVOIR_TUNING_PROFILE_PERMITS=true
ASTRID_EDGE_RESERVOIR_TUNING_MAX_PER_DAY=4
ASTRID_EDGE_AUTONOMY_ENABLED=true
ASTRID_EDGE_AUTONOMY_INTERVAL_MINUTES=10
ASTRID_EDGE_AUTONOMY_EVENT_DRIVEN=false
ASTRID_EDGE_AUTONOMY_EVENT_HEARTBEAT_MINUTES=60
ASTRID_EDGE_AUTONOMY_FOLLOW_UP_MINUTES=3
ASTRID_EDGE_AUTONOMY_MAX_CHAIN_STEPS=6
# Measured full-stack turns rose from 200s fresh to 234s on the second and
# 287s on the third retained turn. Rotate after two; compact verified
# continuity crosses generations without paying for a third history prefill.
ASTRID_EDGE_AUTONOMY_SESSION_MAX_AUTHORED_TURNS=2
ASTRID_EDGE_AUTONOMY_CHAIN_SESSION_MAX_AUTHORED_TURNS=2
ASTRID_EDGE_AUTONOMY_INITIAL_DELAY_SECONDS=60
ASTRID_EDGE_AUTONOMY_QUIET_MINUTES=5
ASTRID_EDGE_AUTONOMY_MAX_TURNS_PER_DAY=96
ASTRID_EDGE_AUTONOMY_TIMEOUT_SECONDS=720
ASTRID_EDGE_AUTONOMY_PROMPT_PROFILE=compact
ASTRID_EDGE_AUTONOMY_PROMPT_MAX_CHARS=1200
ASTRID_EDGE_AUTONOMY_JOURNAL_AUTHORED_TURNS=true
ASTRID_EDGE_AUTONOMY_INITIATIVE_PROFILE=private
ASTRID_EDGE_RESEARCH_ACTION_WEB_SEARCH=true
ASTRID_EDGE_WEB_BROKER_SOCKET_PATH=/run/astrid-edge-self-change/web-runtime.sock
ASTRID_EDGE_WEB_BROKER_CONNECT_TIMEOUT_MS=2000
ASTRID_EDGE_WEB_BROKER_HEADER_TIMEOUT_MS=10000
ASTRID_EDGE_WEB_BROKER_TOTAL_TIMEOUT_MS=30000
# Dedicated reflection is programmatically due every two hours. It has its own
# provenance and never consumes the ordinary autonomy budget.
ASTRID_EDGE_SCHEDULED_INTROSPECTION_ENABLED=false
ASTRID_EDGE_DEDICATED_STEWARD_ENABLED=true
ASTRID_EDGE_DEDICATED_STEWARD_INTERVAL_MINUTES=120
ASTRID_EDGE_STEWARD_SOURCE_AUTHORING_OUTPUT_TOKENS=384
ASTRID_EDGE_SCHEDULED_INTROSPECTION_INTERVAL_MINUTES=120
ASTRID_EDGE_SCHEDULED_INTROSPECTION_INITIAL_DELAY_SECONDS=300
ASTRID_EDGE_SCHEDULED_INTROSPECTION_TIMEOUT_SECONDS=1200
ASTRID_EDGE_SCHEDULED_INTROSPECTION_PROMPT_MAX_CHARS=3200
# The immutable supervisor enables this only after its root-owned policy,
# source snapshot, candidate store, and rollback slots pass bootstrap checks.
ASTRID_EDGE_SELF_CHANGE_ENABLED=false
ASTRID_EDGE_SELF_CHANGE_ROOT=.astrid/self-change
ASTRID_EDGE_PERCEPTUAL_NOTEBOOK_ENABLED=true
ASTRID_EDGE_PERCEPTUAL_NOTEBOOK_WARMUP_SECONDS=300
ASTRID_EDGE_PERCEPTUAL_NOTEBOOK_INTERVAL_SECONDS=900
ASTRID_EDGE_PERCEPTUAL_NOTEBOOK_HEARTBEAT_SECONDS=21600
ASTRID_EDGE_PERCEPTUAL_NOTEBOOK_MAX_PER_DAY=96
ASTRID_OLLAMA_MODEL="qwen3.5:4b"
ASTRID_EDGE_MAINTENANCE_LEASE_PATH="/run/astrid-edge-self-change/maintenance.json"
ASTRID_OLLAMA_SELECTION_STATUS="selected_after_compact_protocol_repair"
ASTRID_OLLAMA_KEEP_ALIVE=2h
ASTRID_OLLAMA_CONTEXT=4096
ASTRID_OLLAMA_MAX_OUTPUT=192
ASTRID_LOCAL_HTTP_RESPONSE_HEADER_TIMEOUT_SECONDS=300
