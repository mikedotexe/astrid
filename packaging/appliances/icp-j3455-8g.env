# Intel Celeron J3455 / 8 GiB / CPU-only ICP appliance.
# Paths are relative to %h/.astrid-icp, the service WorkingDirectory.
TOKIO_WORKER_THREADS=4
ASTRID_EDGE_INSTANCE_NAME="ICP Astrid"
ASTRID_EDGE_TELEMETRY_ADDR=127.0.0.1:7878
ASTRID_EDGE_SENSORY_ADDR=127.0.0.1:7879
ASTRID_EDGE_SOCKET=state/run/system.sock
ASTRID_EDGE_TOKEN=state/run/system.token
ASTRID_EDGE_WORKSPACE=state/home/default/edge
ASTRID_EDGE_ASTRID_CLI=state/bin/astrid
ASTRID_EDGE_AUDIO_DEVICE=off
ASTRID_EDGE_FILL_TARGET=0.68
ASTRID_EDGE_TICK_HZ=20
ASTRID_EDGE_SPECTRAL_ENABLED=true
ASTRID_EDGE_SPECTRAL_ROLLUP_SECONDS=60
# Standing authority is always supplied by the separate owner-controlled
# authority file after observation acceptance.
ASTRID_EDGE_RESERVOIR_TUNING_ENABLED=false
ASTRID_EDGE_RESERVOIR_TUNING_PROFILE_PERMITS=true
ASTRID_EDGE_RESERVOIR_TUNING_MAX_PER_DAY=4
# With thinking disabled, dense Qwen3 1.7B passed grounded honesty, web choice,
# result use, tool restraint, reflection, and sovereign Action cases in 27-59s.
# Native tool emission remains optional through the full prompt, so
# an accepted RESEARCH Action uses the same bounded read-only tool route
# deterministically and carries its audited result into the follow-up.
ASTRID_EDGE_AUTONOMY_ENABLED=true
ASTRID_EDGE_AUTONOMY_INTERVAL_MINUTES=10
# Ordinary reflection follows new host/I/O/source observations, with a bounded
# quiet invitation. Activity-only notebook entries cannot recursively wake it.
ASTRID_EDGE_AUTONOMY_EVENT_DRIVEN=true
ASTRID_EDGE_AUTONOMY_EVENT_HEARTBEAT_MINUTES=60
ASTRID_EDGE_AUTONOMY_FOLLOW_UP_MINUTES=3
ASTRID_EDGE_AUTONOMY_MAX_CHAIN_STEPS=6
# One authored turn per model session keeps the 2K context from doubling the
# next J3455 prefill; compact executor/authored continuity crosses generations.
ASTRID_EDGE_AUTONOMY_SESSION_MAX_AUTHORED_TURNS=1
ASTRID_EDGE_AUTONOMY_CHAIN_SESSION_MAX_AUTHORED_TURNS=1
ASTRID_EDGE_AUTONOMY_INITIAL_DELAY_SECONDS=60
ASTRID_EDGE_AUTONOMY_QUIET_MINUTES=5
ASTRID_EDGE_AUTONOMY_MAX_TURNS_PER_DAY=96
ASTRID_EDGE_AUTONOMY_TIMEOUT_SECONDS=720
ASTRID_EDGE_AUTONOMY_PROMPT_PROFILE=compact
ASTRID_EDGE_AUTONOMY_PROMPT_MAX_CHARS=900
ASTRID_EDGE_AUTONOMY_JOURNAL_AUTHORED_TURNS=true
ASTRID_EDGE_AUTONOMY_INITIATIVE_PROFILE=private
ASTRID_EDGE_RESEARCH_ACTION_WEB_SEARCH=true
ASTRID_EDGE_PERCEPTUAL_NOTEBOOK_ENABLED=true
ASTRID_EDGE_PERCEPTUAL_NOTEBOOK_WARMUP_SECONDS=300
ASTRID_EDGE_PERCEPTUAL_NOTEBOOK_INTERVAL_SECONDS=900
ASTRID_EDGE_PERCEPTUAL_NOTEBOOK_HEARTBEAT_SECONDS=21600
ASTRID_EDGE_PERCEPTUAL_NOTEBOOK_MAX_PER_DAY=96
ASTRID_OLLAMA_MODEL="qwen3:1.7b"
ASTRID_OLLAMA_SELECTION_STATUS="selected_non_thinking_six_case_behavioral_pass"
ASTRID_OLLAMA_KEEP_ALIVE=2h
ASTRID_OLLAMA_CONTEXT=2048
ASTRID_OLLAMA_MAX_OUTPUT=128
ASTRID_LOCAL_HTTP_RESPONSE_HEADER_TIMEOUT_SECONDS=420
