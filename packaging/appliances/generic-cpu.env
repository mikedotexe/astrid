# Generic CPU-only Astrid edge profile. Hardware-specific model selection remains
# gated on scripts/probe_headless_linux.sh and benchmark_headless_models.sh.
ASTRID_EDGE_INSTANCE_NAME="edge Astrid"
ASTRID_EDGE_TELEMETRY_ADDR=127.0.0.1:7878
ASTRID_EDGE_SENSORY_ADDR=127.0.0.1:7879
ASTRID_EDGE_SOCKET=.astrid/run/system.sock
ASTRID_EDGE_TOKEN=.astrid/run/system.token
ASTRID_EDGE_WORKSPACE=.astrid/home/default/edge
ASTRID_EDGE_ASTRID_CLI=.astrid/bin/astrid
ASTRID_EDGE_FILL_TARGET=0.68
ASTRID_EDGE_TICK_HZ=20
ASTRID_EDGE_SPECTRAL_ENABLED=true
ASTRID_EDGE_SPECTRAL_ROLLUP_SECONDS=60
ASTRID_EDGE_RESERVOIR_TUNING_ENABLED=false
ASTRID_EDGE_RESERVOIR_TUNING_PROFILE_PERMITS=false
ASTRID_EDGE_RESERVOIR_TUNING_MAX_PER_DAY=4
ASTRID_EDGE_AUTONOMY_ENABLED=true
ASTRID_EDGE_AUTONOMY_INTERVAL_MINUTES=15
ASTRID_EDGE_AUTONOMY_EVENT_DRIVEN=false
ASTRID_EDGE_AUTONOMY_EVENT_HEARTBEAT_MINUTES=60
ASTRID_EDGE_AUTONOMY_FOLLOW_UP_MINUTES=5
ASTRID_EDGE_AUTONOMY_MAX_CHAIN_STEPS=4
ASTRID_EDGE_AUTONOMY_SESSION_MAX_AUTHORED_TURNS=4
ASTRID_EDGE_AUTONOMY_CHAIN_SESSION_MAX_AUTHORED_TURNS=4
ASTRID_EDGE_AUTONOMY_INITIAL_DELAY_SECONDS=60
ASTRID_EDGE_AUTONOMY_QUIET_MINUTES=10
ASTRID_EDGE_AUTONOMY_MAX_TURNS_PER_DAY=48
ASTRID_EDGE_AUTONOMY_TIMEOUT_SECONDS=720
ASTRID_EDGE_AUTONOMY_PROMPT_PROFILE=compact
ASTRID_EDGE_AUTONOMY_PROMPT_MAX_CHARS=1400
ASTRID_EDGE_RESEARCH_ACTION_WEB_SEARCH=true
ASTRID_EDGE_WEB_BROKER_SOCKET_PATH=/run/astrid-edge-self-change/web-runtime.sock
ASTRID_EDGE_WEB_BROKER_CONNECT_TIMEOUT_MS=2000
ASTRID_EDGE_WEB_BROKER_HEADER_TIMEOUT_MS=10000
ASTRID_EDGE_WEB_BROKER_TOTAL_TIMEOUT_MS=30000
ASTRID_EDGE_SCHEDULED_INTROSPECTION_ENABLED=false
ASTRID_EDGE_DEDICATED_STEWARD_ENABLED=true
ASTRID_EDGE_DEDICATED_STEWARD_INTERVAL_MINUTES=120
ASTRID_EDGE_STEWARD_SOURCE_AUTHORING_OUTPUT_TOKENS=160
ASTRID_EDGE_MAINTENANCE_LEASE_PATH=/run/astrid-edge-self-change/maintenance.json
ASTRID_EDGE_SCHEDULED_INTROSPECTION_INTERVAL_MINUTES=120
ASTRID_EDGE_SCHEDULED_INTROSPECTION_INITIAL_DELAY_SECONDS=300
ASTRID_EDGE_SCHEDULED_INTROSPECTION_TIMEOUT_SECONDS=1200
ASTRID_EDGE_SCHEDULED_INTROSPECTION_PROMPT_MAX_CHARS=2600
ASTRID_EDGE_SELF_CHANGE_ENABLED=false
ASTRID_EDGE_SELF_CHANGE_ROOT=.astrid/self-change
ASTRID_LOCAL_HTTP_RESPONSE_HEADER_TIMEOUT_SECONDS=300
