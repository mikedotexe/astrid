+/// Whether the untouched user message explicitly asks for a named read-only
+/// web tool. Keep this narrow so mere discussion or system context cannot
+/// force tool use.
+fn explicitly_requests_read_only_web_tool(text: &str) -> bool {
+    let normalized = text.to_ascii_lowercase();
+    [
+        "call search_web",
+        "use search_web",
+        "call fetch_url",
+        "use fetch_url",
+    ]
+    .iter()
+    .any(|phrase| normalized.contains(phrase))
+}
