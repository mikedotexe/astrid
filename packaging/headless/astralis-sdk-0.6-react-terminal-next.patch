+const RESPONSE_PROVENANCE_MODEL_AUTHORED: &str = "model_authored";
+const RESPONSE_PROVENANCE_SAFE_FALLBACK: &str = "model_authored_with_local_safe_fallback";
+const RESPONSE_PROVENANCE_FORMAT_REPAIR: &str = "model_authored_with_local_format_repair";
+const RESPONSE_PROVENANCE_EXECUTOR_ERROR: &str = "executor_terminal_error";
+
+#[derive(Debug, PartialEq, Eq)]
+struct FinalizedResponse {
+    /// Terminal bytes published to the client, including any visible repair.
+    text: String,
+    /// Exact model bytes admitted to session history.
+    /// Executor output has no authored history representation.
+    authored_history_text: Option<String>,
+    response_provenance: &'static str,
+}
+
+/// Apply the appliance action contract while retaining exact response origin.
+fn finalize_model_response(text: &str) -> FinalizedResponse {
+    finalize_model_response_with_repair(text, sovereign_next_repair_enabled())
+}
+
+fn finalize_model_response_with_repair(text: &str, repair_enabled: bool) -> FinalizedResponse {
+    if !repair_enabled {
+        return FinalizedResponse {
+            text: text.to_owned(),
+            authored_history_text: Some(text.to_owned()),
+            response_provenance: RESPONSE_PROVENANCE_MODEL_AUTHORED,
+        };
+    }
+    let (finalized, response_provenance) = if has_valid_sovereign_next(text) {
+        (text.to_owned(), RESPONSE_PROVENANCE_MODEL_AUTHORED)
+    } else if let Some(repaired) = canonicalize_split_argument_next(text) {
+        (repaired, RESPONSE_PROVENANCE_FORMAT_REPAIR)
+    } else if let Some(repaired) = canonicalize_embedded_terminal_next(text) {
+        (repaired, RESPONSE_PROVENANCE_FORMAT_REPAIR)
+    } else {
+        (
+            ensure_sovereign_next(text),
+            RESPONSE_PROVENANCE_SAFE_FALLBACK,
+        )
+    };
+    FinalizedResponse {
+        text: finalized,
+        authored_history_text: Some(text.to_owned()),
+        response_provenance,
+    }
+}
+
+/// Executor failures stay visibly non-authored even when made grammar-safe.
+fn finalize_executor_error(text: &str) -> FinalizedResponse {
+    finalize_executor_error_with_repair(text, sovereign_next_repair_enabled())
+}
+
+fn finalize_executor_error_with_repair(text: &str, repair_enabled: bool) -> FinalizedResponse {
+    let text = if repair_enabled {
+        ensure_sovereign_next(text)
+    } else {
+        text.trim_end().to_owned()
+    };
+    FinalizedResponse {
+        text,
+        authored_history_text: None,
+        response_provenance: RESPONSE_PROVENANCE_EXECUTOR_ERROR,
+    }
+}
+
+fn publish_final_response(session_id: &str, response: &FinalizedResponse) -> Result<(), SysError> {
+    ipc::publish_json(
+        "agent.v1.response",
+        &serde_json::json!({
+            "type": "agent_response",
+            "text": &response.text,
+            "is_final": true,
+            "session_id": session_id,
+            "response_provenance": response.response_provenance,
+        }),
+    )
+}
