+#[cfg(test)]
+mod response_provenance_tests {
+    use super::{
+        FORMAT_NEXT_REPAIR_MARKER, RESPONSE_PROVENANCE_EXECUTOR_ERROR,
+        RESPONSE_PROVENANCE_FORMAT_REPAIR, RESPONSE_PROVENANCE_MODEL_AUTHORED,
+        RESPONSE_PROVENANCE_SAFE_FALLBACK, finalize_executor_error_with_repair,
+        finalize_model_response_with_repair,
+    };
+
+    #[test]
+    fn classifies_exact_safe_and_format_repaired_model_responses() {
+        let exact_bytes = "Reflection.\nNEXT: REST\n  ";
+        let exact = finalize_model_response_with_repair(exact_bytes, true);
+        assert_eq!(
+            exact.response_provenance,
+            RESPONSE_PROVENANCE_MODEL_AUTHORED
+        );
+        assert_eq!(exact.text, exact_bytes);
+        assert_eq!(exact.authored_history_text.as_deref(), Some(exact_bytes));
+
+        let safe = finalize_model_response_with_repair("Reflection without an Action.", true);
+        assert_eq!(safe.response_provenance, RESPONSE_PROVENANCE_SAFE_FALLBACK);
+        assert_eq!(
+            safe.authored_history_text.as_deref(),
+            Some("Reflection without an Action.")
+        );
+        assert!(
+            !safe
+                .authored_history_text
+                .as_deref()
+                .unwrap()
+                .contains("Local contract repair")
+        );
+
+        let marker_spoof =
+            format!("Model bytes mentioning {FORMAT_NEXT_REPAIR_MARKER}\nNEXT: REST\n ");
+        let spoofed = finalize_model_response_with_repair(&marker_spoof, true);
+        assert_eq!(
+            spoofed.response_provenance,
+            RESPONSE_PROVENANCE_MODEL_AUTHORED
+        );
+        assert_eq!(spoofed.text, marker_spoof);
+        assert_eq!(
+            spoofed.authored_history_text.as_deref(),
+            Some(marker_spoof.as_str())
+        );
+
+        let invalid_marker_spoof =
+            format!("Model bytes mentioning {FORMAT_NEXT_REPAIR_MARKER} without an Action.");
+        let invalid_spoofed = finalize_model_response_with_repair(&invalid_marker_spoof, true);
+        assert_eq!(
+            invalid_spoofed.response_provenance,
+            RESPONSE_PROVENANCE_SAFE_FALLBACK
+        );
+
+        let tuning = finalize_model_response_with_repair(
+            "A bounded trial. NEXT: TUNE_RESERVOIR input_gain=1.05 FOR 15m :: test",
+            true,
+        );
+        assert_eq!(
+            tuning.response_provenance,
+            RESPONSE_PROVENANCE_FORMAT_REPAIR
+        );
+        assert!(tuning.text.contains(FORMAT_NEXT_REPAIR_MARKER));
+        assert_eq!(
+            tuning.authored_history_text.as_deref(),
+            Some("A bounded trial. NEXT: TUNE_RESERVOIR input_gain=1.05 FOR 15m :: test")
+        );
+        assert!(
+            !tuning
+                .authored_history_text
+                .as_deref()
+                .unwrap()
+                .contains(FORMAT_NEXT_REPAIR_MARKER)
+        );
+    }
+
+    #[test]
+    fn executor_terminal_errors_remain_non_authored_after_safe_repair() {
+        let response = finalize_executor_error_with_repair("LLM error: unavailable", true);
+        assert_eq!(
+            response.response_provenance,
+            RESPONSE_PROVENANCE_EXECUTOR_ERROR
+        );
+        assert!(response.authored_history_text.is_none());
+        assert!(response.text.ends_with("NEXT: LISTEN"));
+    }
+}
