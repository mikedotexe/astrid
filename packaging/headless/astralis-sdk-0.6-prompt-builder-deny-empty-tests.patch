diff --git a/src/tests.rs b/src/tests.rs
index daf5417..b43a9ec 100644
--- a/src/tests.rs
+++ b/src/tests.rs
@@ -1 +1,18 @@
+#[test]
+fn model_tool_allowlist_is_deny_all_when_empty_and_exact_when_populated() {
+    let discovered = vec![
+        serde_json::json!({"name": "search_web"}),
+        serde_json::json!({"name": "read_owned_artifact"}),
+        serde_json::json!({"description": "malformed without a name"}),
+    ];
+    assert!(
+        select_allowlisted_tool_schemas(discovered.clone(), &std::collections::HashSet::new())
+            .is_empty()
+    );
+
+    let allowlist = ["search_web".to_string()].into_iter().collect();
+    let selected = select_allowlisted_tool_schemas(discovered, &allowlist);
+    assert_eq!(selected, [serde_json::json!({"name": "search_web"})]);
+}
