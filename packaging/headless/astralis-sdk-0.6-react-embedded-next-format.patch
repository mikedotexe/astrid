+/// Repair only the layout of one unambiguous terminal action authored at the
+/// end of the model's final line. The action bytes themselves are unchanged.
+fn canonicalize_embedded_terminal_next(text: &str) -> Option<String> {
+    let trimmed = text.trim_end();
+    if trimmed.matches("NEXT:").count() != 1 {
+        return None;
+    }
+    let line_start = trimmed
+        .rfind('\n')
+        .map_or(0, |position| position.saturating_add(1));
+    let final_line = trimmed.get(line_start..)?;
+    let marker = final_line.rfind("NEXT:")?;
+    if marker == 0
+        || !final_line
+            .get(..marker)?
+            .chars()
+            .next_back()
+            .is_some_and(char::is_whitespace)
+    {
+        return None;
+    }
+    let declaration = final_line.get(marker..)?.trim();
+    if !has_valid_sovereign_next(declaration) {
+        return None;
+    }
+    let prefix_end = line_start.saturating_add(marker);
+    let prefix = trimmed.get(..prefix_end)?.trim_end();
+    Some(format!(
+        "{prefix}\n\n{FORMAT_NEXT_REPAIR_MARKER}\n{declaration}"
+    ))
+}
