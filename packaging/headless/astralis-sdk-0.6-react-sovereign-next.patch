+#[cfg(test)]
+mod sovereign_next_tests {
+    use super::{SAFE_NEXT_REPAIR_MARKER, ensure_sovereign_next, has_valid_sovereign_next};
+
+    #[test]
+    fn accepts_only_complete_supported_final_actions() {
+        assert!(has_valid_sovereign_next("A response.\nNEXT: LISTEN"));
+        assert!(has_valid_sovereign_next(
+            "A response.\nNEXT: SELF_STUDY What changes after input?"
+        ));
+        assert!(has_valid_sovereign_next(
+            "A response.\nNEXT: REVISE draft_123.md :: clarify the distinction"
+        ));
+        assert!(!has_valid_sovereign_next(
+            "A response.\nNEXT: REVISE draft_123.md"
+        ));
+        assert!(!has_valid_sovereign_next(
+            "NEXT: JOURNAL not final\nA response."
+        ));
+        assert!(!has_valid_sovereign_next("A response.\nNEXT: JOURNAL"));
+        assert!(!has_valid_sovereign_next("A response.\nNEXT: RUN"));
+    }
+
+    #[test]
+    fn preserves_a_model_authored_action() {
+        assert_eq!(
+            ensure_sovereign_next("A response.\n\nNEXT: REST\n"),
+            "A response.\n\nNEXT: REST"
+        );
+    }
+
+    #[test]
+    fn repairs_only_to_a_transparent_non_writing_listen() {
+        assert_eq!(
+            ensure_sovereign_next("A response without an action."),
+            format!("A response without an action.\n\n{SAFE_NEXT_REPAIR_MARKER}\nNEXT: LISTEN")
+        );
+        assert_eq!(
+            ensure_sovereign_next("A response.\nNEXT: JOURNAL"),
+            format!("A response.\nNEXT: JOURNAL\n\n{SAFE_NEXT_REPAIR_MARKER}\nNEXT: LISTEN")
+        );
+    }
+}
