+/// Visible marker used when the appliance repairs an absent action declaration.
+///
+/// The only synthetic action is LISTEN, which cannot mutate the workspace.
+const SAFE_NEXT_REPAIR_MARKER: &str =
+    "[Local contract repair: no valid final action was emitted; defaulting safely to LISTEN.]";
+
+/// Return whether the final non-empty line is a complete sovereign NEXT action.
+fn has_valid_sovereign_next(text: &str) -> bool {
+    let Some(final_line) = text.lines().rev().find(|line| !line.trim().is_empty()) else {
+        return false;
+    };
+    let final_line = final_line.trim();
+    if matches!(final_line, "NEXT: LISTEN" | "NEXT: REST") {
+        return true;
+    }
+    [
+        "NEXT: JOURNAL ",
+        "NEXT: REMEMBER ",
+        "NEXT: SELF_STUDY ",
+        "NEXT: PROPOSE ",
+        "NEXT: NOTICE ",
+        "NEXT: DAYDREAM ",
+        "NEXT: ASPIRE ",
+        "NEXT: RESEARCH ",
+        "NEXT: PLAN ",
+        "NEXT: DRAFT ",
+        "NEXT: CHECK ",
+    ]
+    .iter()
+    .any(|prefix| {
+        final_line
+            .strip_prefix(prefix)
+            .is_some_and(|argument| !argument.trim().is_empty())
+    })
+        || final_line.strip_prefix("NEXT: REVISE ").is_some_and(|argument| {
+            argument
+                .split_once("::")
+                .is_some_and(|(artifact, revision)| {
+                    !artifact.trim().is_empty() && !revision.trim().is_empty()
+                })
+        })
+}
+
+/// Preserve a valid model-authored declaration or append a transparent,
+/// non-writing LISTEN fallback.
+fn ensure_sovereign_next(text: &str) -> String {
+    let trimmed = text.trim_end();
+    if has_valid_sovereign_next(trimmed) {
+        return trimmed.to_owned();
+    }
+    if trimmed.is_empty() {
+        format!("{SAFE_NEXT_REPAIR_MARKER}\nNEXT: LISTEN")
+    } else {
+        format!("{trimmed}\n\n{SAFE_NEXT_REPAIR_MARKER}\nNEXT: LISTEN")
+    }
+}
+
+/// Whether the appliance-specific sovereign NEXT repair is enabled.
+fn sovereign_next_repair_enabled() -> bool {
+    env::var("sovereign_next_repair").is_ok_and(|value| value.eq_ignore_ascii_case("true"))
+}
+
 /// Current wall-clock time as milliseconds since UNIX epoch, or 0 if unavailable.
 fn now_ms() -> u64 {
     time::now()
