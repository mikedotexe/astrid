+++ b/src/lib.rs
@@ -319,7 +319,7 @@ impl OpenAICompatProvider {
             }
         }
 
-        // Handle finish reason: emit ToolCallEnd for all active tool calls.
+        // Handle finish reason: close tool calls, then complete the stream.
