+fn test_config(explicit_only: bool) -> Config {
+    Config {
+        hook_timeout_ms: 100,
+        tool_allowlist: ["search_web".to_string(), "fetch_url".to_string()]
+            .into_iter()
+            .collect(),
+        web_tools_on_explicit_request_only: explicit_only,
+    }
+}
+
+#[test]
+fn explicit_web_tool_activation_uses_only_the_latest_user_message() {
+    let ordinary = serde_json::json!([
+        {"role": "user", "content": "Earlier, use search_web for a question."},
+        {"role": "assistant", "content": "Earlier answer."},
+        {"role": "user", "content": "Reflect only on the local reservoir."}
+    ]);
+    assert!(!latest_user_explicitly_needs_web_tools(&ordinary));
+
+    for content in [
+        "Call search_web now for public evidence.",
+        "Please use fetch_url for https://example.com.",
+        "Search the web for the current release.",
+        "Run a web search for this exact phrase.",
+        "Read https://example.com.",
+    ] {
+        let messages = serde_json::json!([{"role": "user", "content": content}]);
+        assert!(latest_user_explicitly_needs_web_tools(&messages));
+    }
+
+    let discussion = serde_json::json!([
+        {"role": "user", "content": "Discuss public research without browsing."}
+    ]);
+    assert!(!latest_user_explicitly_needs_web_tools(&discussion));
+}
+
+#[test]
+fn explicit_only_profile_omits_ordinary_tools_but_not_requested_tools() {
+    let ordinary = AssembleRequest {
+        messages: serde_json::json!([
+            {"role": "user", "content": "Reflect on local state."}
+        ]),
+        system_prompt: String::new(),
+        request_id: "ordinary".to_string(),
+        model: String::new(),
+        provider: String::new(),
+        session_id: None,
+    };
+    assert!(!should_expose_tools(&ordinary, &test_config(true)));
+    assert!(should_expose_tools(&ordinary, &test_config(false)));
+
+    let research = AssembleRequest {
+        messages: serde_json::json!([
+            {"role": "user", "content": "Research continuation: Call search_web now."}
+        ]),
+        request_id: "research".to_string(),
+        ..ordinary
+    };
+    assert!(should_expose_tools(&research, &test_config(true)));
+}
