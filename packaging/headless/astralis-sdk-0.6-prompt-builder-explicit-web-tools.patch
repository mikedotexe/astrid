+/// Whether the latest untouched user message explicitly needs the read-only
+/// web surface. Prior assistant text and system context cannot activate it.
+fn latest_user_explicitly_needs_web_tools(messages: &serde_json::Value) -> bool {
+    let Some(messages) = messages.as_array() else {
+        return false;
+    };
+    let Some(text) = messages.iter().rev().find_map(|message| {
+        (message.get("role").and_then(serde_json::Value::as_str) == Some("user"))
+            .then(|| message.get("content").and_then(serde_json::Value::as_str))
+            .flatten()
+    }) else {
+        return false;
+    };
+    let normalized = text.to_ascii_lowercase();
+    [
+        "search_web",
+        "fetch_url",
+        "search the web",
+        "search web",
+        "web search",
+        "http://",
+        "https://",
+    ]
+    .iter()
+    .any(|marker| normalized.contains(marker))
+}
+
+fn should_expose_tools(request: &AssembleRequest, config: &Config) -> bool {
+    !config.web_tools_on_explicit_request_only
+        || latest_user_explicitly_needs_web_tools(&request.messages)
+}
