@@ -96,13 +96,34 @@ fn has_valid_sovereign_next(text: &str) -> bool {
         "NEXT: REMEMBER ",
         "NEXT: SELF_STUDY ",
         "NEXT: PROPOSE ",
+        "NEXT: NOTICE ",
+        "NEXT: DAYDREAM ",
+        "NEXT: ASPIRE ",
+        "NEXT: RESEARCH ",
+        "NEXT: PLAN ",
+        "NEXT: DRAFT ",
+        "NEXT: READ ",
+        "NEXT: READ_SOURCE ",
+        "NEXT: CHECK ",
+        "NEXT: MEASURE ",
+        "NEXT: STUDY ",
+        "NEXT: CANCEL_STUDY ",
+        "NEXT: SYNTHESIZE ",
+        "NEXT: SHARE ",
     ]
     .iter()
     .any(|prefix| {
         final_line
             .strip_prefix(prefix)
             .is_some_and(|argument| !argument.trim().is_empty())
     })
+        || final_line.strip_prefix("NEXT: REVISE ").is_some_and(|argument| {
+            argument
+                .split_once("::")
