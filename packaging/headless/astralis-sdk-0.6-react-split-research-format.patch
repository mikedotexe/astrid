+/// Repair a small-model line break between one argument-bearing `NEXT` verb
+/// and its single-line argument. Both pieces must be the final two non-empty
+/// lines, and no second action marker may appear anywhere.
+fn canonicalize_split_argument_next(text: &str) -> Option<String> {
+    let trimmed = text.trim_end();
+    if trimmed.matches("NEXT:").count() != 1 {
+        return None;
+    }
+    let final_line_start = trimmed
+        .rfind('\n')
+        .map_or(0, |position| position.saturating_add(1));
+    let argument = trimmed.get(final_line_start..)?.trim();
+    if argument.is_empty()
+        || argument.chars().count() > 2_000
+        || argument.chars().any(char::is_control)
+    {
+        return None;
+    }
+    let before_question = trimmed.get(..final_line_start)?.trim_end();
+    let declaration_line_start = before_question
+        .rfind('\n')
+        .map_or(0, |position| position.saturating_add(1));
+    let verb = before_question
+        .get(declaration_line_start..)?
+        .trim()
+        .strip_prefix("NEXT:")?
+        .trim();
+    if !matches!(
+        verb,
+        "JOURNAL"
+            | "REMEMBER"
+            | "SELF_STUDY"
+            | "PROPOSE"
+            | "NOTICE"
+            | "DAYDREAM"
+            | "ASPIRE"
+            | "RESEARCH"
+            | "PLAN"
+            | "DRAFT"
+            | "READ"
+            | "READ_SOURCE"
+            | "REVISE"
+            | "CHECK"
+            | "MEASURE"
+            | "STUDY"
+            | "CANCEL_STUDY"
+            | "SYNTHESIZE"
+            | "SHARE"
+            | "TUNE_RESERVOIR"
+            | "CANCEL_TUNING"
+            | "VALIDATE_TUNING"
+            | "ADOPT_TUNING"
+            | "REVERT_TUNING"
+    ) {
+        return None;
+    }
+    let declaration = format!("NEXT: {verb} {argument}");
+    if !has_valid_sovereign_next(&declaration) {
+        return None;
+    }
+    let prefix = before_question
+        .get(..declaration_line_start)?
+        .trim_end();
+    if prefix.is_empty() {
+        Some(format!("{FORMAT_NEXT_REPAIR_MARKER}\n{declaration}"))
+    } else {
+        Some(format!(
+            "{prefix}\n\n{FORMAT_NEXT_REPAIR_MARKER}\n{declaration}"
+        ))
+    }
+}
