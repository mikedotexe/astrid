[Unit]
Description=Astrid CPU-edge immutable direct-ALSA numeric feature feeder
Documentation=https://github.com/unicity-astrid/astrid
Requires=astrid-edge-audio-feeder.socket
After=astrid-edge-audio-feeder.socket sound.target

[Service]
Type=simple
User=astrid-edge-audio
Group=astrid-edge-audio
Sockets=astrid-edge-audio-feeder.socket
StandardInput=socket
StandardOutput=journal
StandardError=journal
ExecStart=/usr/bin/python3 -I -E -s /usr/libexec/astrid-edge/immutable/edge_audio_feeder.py --config /etc/astrid-edge-self-change/audio-feeder.json
Restart=on-failure
RestartSec=10s
TimeoutStopSec=10s
KillMode=mixed
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=char-alsa rw
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service
SystemCallFilter=~@clock @debug @module @mount @obsolete @privileged @raw-io @reboot @swap
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/etc/astrid-edge-self-change/audio-feeder.json
InaccessiblePaths=/home /root /media/data/astrid /var/lib/astrid-edge-provider /var/lib/astrid-edge-web-runtime /var/lib/astrid-edge-web-steward
NoExecPaths=/
ExecPaths=/usr/bin/python3 /usr/lib /lib /lib64
TasksMax=16
MemoryHigh=67108864
MemoryMax=100663296
MemorySwapMax=0
CPUQuota=20%
IOWeight=10
