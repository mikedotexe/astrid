[Unit]
Description=Reconcile interrupted Astrid CPU-edge state migration and signed inode reserve transaction
Documentation=file:@@ACTIVE_GENERATION_ROOT@@/docs/cpu-edge-self-evolution.md
Requires=@@RUNTIME_MOUNT_UNIT@@ @@ROLLBACK_MOUNT_UNIT@@
After=@@RUNTIME_MOUNT_UNIT@@ @@ROLLBACK_MOUNT_UNIT@@
Before=astrid-edge-state-store-verify.service astrid-edge-generation-guard.service
RequiresMountsFor=@@BACKING_ROOT@@

[Service]
Type=oneshot
User=root
Group=root
ExecStartPre=/usr/bin/test -s /etc/astrid/edge-state-store.json
ExecStartPre=/usr/bin/test -x /usr/libexec/astrid/astrid-edge-state-store
ExecStartPre=/usr/bin/test -s /etc/astrid/edge-rescue-helper.json
ExecStartPre=/usr/bin/test -x /usr/libexec/astrid/astrid-edge-rescue-helper
ExecStart=/usr/libexec/astrid/astrid-edge-rescue-helper --config /etc/astrid/edge-rescue-helper.json reconcile-storage-reserve
RemainAfterExit=yes
UMask=0077
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
AmbientCapabilities=
NoNewPrivileges=yes
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=block-loop r
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/astrid/edge-state-store.json /etc/astrid/edge-rescue-helper.json @@RUNTIME_IMAGE@@ @@ROLLBACK_IMAGE@@
ReadWritePaths=@@RUNTIME_STATE_ROOT@@ @@ROLLBACK_STATE_ROOT@@
NoExecPaths=/
ExecPaths=/usr/bin/python3 /usr/bin/findmnt /usr/bin/systemd-escape /usr/bin/test /usr/sbin/blkid /usr/sbin/dumpe2fs /usr/sbin/losetup /usr/libexec/astrid/astrid-edge-state-store /usr/libexec/astrid/astrid-edge-rescue-helper /usr/lib /usr/lib64 /lib /lib64
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service
SystemCallFilter=~@clock @debug @module @mount @obsolete @raw-io @reboot @swap

[Install]
WantedBy=multi-user.target
