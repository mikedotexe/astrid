[Unit]
Description=Astrid CPU-edge immutable probation health sample
Documentation=https://github.com/unicity-astrid/astrid
Requires=astrid-edge-generation-guard.service
After=local-fs.target astrid-edge-generation-guard.service astrid-edge-runtime.service
JoinsNamespaceOf=astrid-edge-runtime.service

[Service]
Type=oneshot
User=root
Group=root
ExecStartPre=/usr/bin/test -s /etc/astrid/edge-service-manager.json
ExecStartPre=/usr/bin/test -s /etc/astrid/edge-self-change.json
ExecStartPre=/usr/bin/test -s /etc/astrid/edge-self-change.key
ExecStartPre=/usr/bin/test -s /etc/astrid/edge-self-evolution-intent.key
ExecStartPre=/usr/bin/test -x /usr/libexec/astrid/edge-self-change-supervisor
ExecStart=/usr/bin/python3 -I -E -s /usr/libexec/astrid/edge-self-change-supervisor --config /etc/astrid/edge-self-change.json --execute check-probation
# A failed health sample may synchronously invoke the immutable rollback profile.
TimeoutStartSec=2h 10min
TimeoutStopSec=30s
KillMode=mixed
UMask=0077
# The root bootstrap installs the same exact state/release namespace as the
# supervisor service. The shared authenticated supervisor lock serializes both.
NoNewPrivileges=yes
PrivateDevices=yes
# Probation samples the live reservoir only inside the edge runtime's private
# network namespace. It never receives host-network or general egress.
PrivateNetwork=yes
IPAddressDeny=any
IPAddressAllow=localhost
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/astrid
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_KILL CAP_SETGID CAP_SETUID
AmbientCapabilities=
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service
SystemCallFilter=~@clock @debug @module @mount @obsolete @raw-io @reboot @swap
NoExecPaths=/
ExecPaths=/usr/bin/python3 /usr/bin/test /usr/lib /usr/lib64 /lib /lib64
