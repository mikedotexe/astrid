[Unit]
Description=Astrid CPU-edge core web-broker socket
Documentation=https://github.com/unicity-astrid/astrid

[Socket]
ListenStream=/run/astrid-edge-self-change/web-core.sock
SocketUser=root
SocketGroup=@@CORE_GROUP@@
SocketMode=0660
DirectoryMode=0755
Accept=no
Service=astrid-edge-web-broker-core.service
RemoveOnStop=yes
FlushPending=yes
Backlog=16

[Install]
WantedBy=sockets.target
