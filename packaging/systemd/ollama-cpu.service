[Unit]
Description=Local CPU model service for Astrid
Documentation=https://docs.ollama.com/linux
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=%h/.local/share/ollama/models
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_KEEP_ALIVE=2h
Environment=OLLAMA_CONTEXT_LENGTH=4096
ExecStart=%h/.local/bin/ollama serve
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077
LimitNOFILE=65536
TasksMax=512

[Install]
WantedBy=default.target
