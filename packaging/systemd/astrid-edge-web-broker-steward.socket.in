[Unit]
Description=Astrid CPU-edge steward web-broker socket
Documentation=https://github.com/unicity-astrid/astrid

[Socket]
ListenStream=/run/astrid-edge-self-change/web-steward.sock
SocketUser=root
SocketGroup=@@STEWARD_GROUP@@
SocketMode=0660
# The shared parent remains root-owned and non-writable while both client
# identities retain traversal to their separately permissioned sockets.
DirectoryMode=0755
Accept=no
Service=astrid-edge-web-broker-steward.service
RemoveOnStop=yes
FlushPending=yes
Backlog=16

[Install]
WantedBy=sockets.target
