#!/usr/bin/env bash
# Transactionally move the fixed CPU-edge service stack from a user manager to
# root-owned system units which continue to run as the appliance identity.
set -euo pipefail
IFS=$'\n\t'
umask 077
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

dry_run=false
render_only=false
start_services=false
profile= appliance_id= runtime_user= runtime_home= unit_source_root= user_unit_root= system_unit_root=
rescue_system_unit_root=
active_generation_root= management_marker= self_evolution_dropin_sha256=
post_install_verifier= post_install_verifier_config=
model_lock= maintenance_lease= authority_env=
unit_policy=
ollama_binary= ollama_binary_sha256=
operator_report_manifest_sha256=
required_mount= required_mount_uuid=
provider_output_tokens=
completion_marker=
state_store_helper= state_store_helper_sha256= state_store_config=
state_store_runtime_mount_unit= state_store_rollback_mount_unit=
state_store_verify_unit= state_store_health_timer=
source_root= candidate_root= builder_root= updater_root= toolchain_root=
output_root= render_state_device= render_web_response_verify_sha256= render_audio_feeder_uid=
declare -a requested_units=() requested_hash_specs=() profile_dropin_hash_specs=()

die() { printf 'error: %s\n' "$*" >&2; exit 2; }
need_value() { [[ $# -ge 2 && -n $2 ]] || die "missing value for $1"; }
usage() {
    cat <<'EOF'
usage: migrate-edge-user-services-to-system [--dry-run | --render-only --output-root ABS] [--start-services]
  --profile avado|icp --runtime-user USER --runtime-home ABS
  --appliance-id SAFE-ID
  --unit-source-root ABS --user-unit-root ABS --system-unit-root /etc/systemd/system
  --rescue-system-unit-root UPDATER_ROOT/system-units
  --active-generation-root ABS/current
  --management-marker /etc/astrid/edge-service-manager.json
  --self-evolution-dropin-sha256 HEX64
  --post-install-verifier ABS --post-install-verifier-config ABS
  --model-lock ABS (persistent root-owned shared lock)
  --maintenance-lease ABS (persistent root-owned dynamic lease)
  --authority-env /etc/astrid/edge-self-change-authority.env
  --unit-policy SUPERVISOR_STATE/unit-policy.json
  --ollama-binary ABS --ollama-binary-sha256 HEX64
  --operator-report-manifest-sha256 HEX64
  --provider-output-tokens N (exact active capsule and gateway ceiling)
  --state-store-helper ABS --state-store-helper-sha256 HEX64
  --state-store-config /etc/astrid/edge-state-store.json
  --state-store-runtime-mount-unit NAME.mount
  --state-store-rollback-mount-unit NAME.mount
  --state-store-verify-unit astrid-edge-state-store-verify.service
  --state-store-health-timer astrid-edge-state-store-health.timer
  --source-root ABS --candidate-root ABS --builder-root ABS
  --updater-root ABS --toolchain-root ABS
  --unit NAME --unit-sha256 NAME=HEX (repeat for the exact six-unit stack)
  --profile-dropin-sha256 NAME=HEX (repeat for the exact profile drop-ins)
  [--required-mount /media/data --required-mount-uuid UUID]
  Render-only fixture values:
  --render-state-device /dev/disk/by-uuid/UUID
  --render-web-response-verify-sha256 HEX64
  [--render-audio-feeder-uid UID] (required for AVADO)
  Real execution also requires --completion-marker PRIVATE_ROOT_DIR/system-migration.complete.
EOF
}

while (($#)); do
    case "$1" in
        --dry-run) dry_run=true; shift ;;
        --render-only) render_only=true; shift ;;
        --output-root) need_value "$@"; output_root=$2; shift 2 ;;
        --render-state-device) need_value "$@"; render_state_device=$2; shift 2 ;;
        --render-web-response-verify-sha256) need_value "$@"; render_web_response_verify_sha256=$2; shift 2 ;;
        --render-audio-feeder-uid) need_value "$@"; render_audio_feeder_uid=$2; shift 2 ;;
        --start-services) start_services=true; shift ;;
        --profile) need_value "$@"; profile=$2; shift 2 ;;
        --appliance-id) need_value "$@"; appliance_id=$2; shift 2 ;;
        --runtime-user) need_value "$@"; runtime_user=$2; shift 2 ;;
        --runtime-home) need_value "$@"; runtime_home=$2; shift 2 ;;
        --unit-source-root) need_value "$@"; unit_source_root=$2; shift 2 ;;
        --user-unit-root) need_value "$@"; user_unit_root=$2; shift 2 ;;
        --system-unit-root) need_value "$@"; system_unit_root=$2; shift 2 ;;
        --rescue-system-unit-root) need_value "$@"; rescue_system_unit_root=$2; shift 2 ;;
        --active-generation-root) need_value "$@"; active_generation_root=$2; shift 2 ;;
        --management-marker) need_value "$@"; management_marker=$2; shift 2 ;;
        --self-evolution-dropin-sha256) need_value "$@"; self_evolution_dropin_sha256=$2; shift 2 ;;
        --post-install-verifier) need_value "$@"; post_install_verifier=$2; shift 2 ;;
        --post-install-verifier-config) need_value "$@"; post_install_verifier_config=$2; shift 2 ;;
        --model-lock) need_value "$@"; model_lock=$2; shift 2 ;;
        --maintenance-lease) need_value "$@"; maintenance_lease=$2; shift 2 ;;
        --authority-env) need_value "$@"; authority_env=$2; shift 2 ;;
        --unit-policy) need_value "$@"; unit_policy=$2; shift 2 ;;
        --ollama-binary) need_value "$@"; ollama_binary=$2; shift 2 ;;
        --ollama-binary-sha256) need_value "$@"; ollama_binary_sha256=$2; shift 2 ;;
        --operator-report-manifest-sha256) need_value "$@"; operator_report_manifest_sha256=$2; shift 2 ;;
        --provider-output-tokens) need_value "$@"; provider_output_tokens=$2; shift 2 ;;
        --state-store-helper) need_value "$@"; state_store_helper=$2; shift 2 ;;
        --state-store-helper-sha256) need_value "$@"; state_store_helper_sha256=$2; shift 2 ;;
        --state-store-config) need_value "$@"; state_store_config=$2; shift 2 ;;
        --state-store-runtime-mount-unit) need_value "$@"; state_store_runtime_mount_unit=$2; shift 2 ;;
        --state-store-rollback-mount-unit) need_value "$@"; state_store_rollback_mount_unit=$2; shift 2 ;;
        --state-store-verify-unit) need_value "$@"; state_store_verify_unit=$2; shift 2 ;;
        --state-store-health-timer) need_value "$@"; state_store_health_timer=$2; shift 2 ;;
        --source-root) need_value "$@"; source_root=$2; shift 2 ;;
        --candidate-root) need_value "$@"; candidate_root=$2; shift 2 ;;
        --builder-root) need_value "$@"; builder_root=$2; shift 2 ;;
        --updater-root) need_value "$@"; updater_root=$2; shift 2 ;;
        --toolchain-root) need_value "$@"; toolchain_root=$2; shift 2 ;;
        --unit) need_value "$@"; requested_units+=("$2"); shift 2 ;;
        --unit-sha256) need_value "$@"; requested_hash_specs+=("$2"); shift 2 ;;
        --profile-dropin-sha256) need_value "$@"; profile_dropin_hash_specs+=("$2"); shift 2 ;;
        --required-mount) need_value "$@"; required_mount=$2; shift 2 ;;
        --required-mount-uuid) need_value "$@"; required_mount_uuid=$2; shift 2 ;;
        --completion-marker) need_value "$@"; completion_marker=$2; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        *) die "unsupported argument: $1" ;;
    esac
done

[[ $profile == avado || $profile == icp ]] || die "profile must be avado or icp"
if $dry_run && $render_only; then
    die "--dry-run and --render-only are mutually exclusive"
fi
live_run=true
if $dry_run || $render_only; then live_run=false; fi
if $render_only; then
    ! $start_services || die "--render-only cannot start services"
    [[ -n $output_root ]] || die "--render-only requires --output-root"
    [[ $output_root == /* && $output_root != / && $output_root != *'/../'* && $output_root != */.. && $output_root != *' '* ]] \
        || die "unsafe render output root: $output_root"
    [[ -d $output_root && ! -L $output_root ]] || die "render output root must be an existing non-symlink directory"
    [[ -O $output_root ]] || die "render output root must be owned by the invoking identity"
    [[ -z $(find "$output_root" -maxdepth 0 -perm -0022 -print) ]] || die "render output root must not be group/world writable"
    [[ -z $(find "$output_root" -mindepth 1 -maxdepth 1 -print -quit) ]] || die "render output root must be empty"
    [[ $render_state_device == /dev/disk/by-uuid/* && $render_state_device != *'/../'* && $render_state_device != *' '* ]] \
        || die "render state device must use the stable /dev/disk/by-uuid namespace"
    [[ $render_web_response_verify_sha256 =~ ^[0-9a-f]{64}$ ]] \
        || die "render web response verifier SHA-256 is invalid"
    if [[ $profile == avado ]]; then
        [[ $render_audio_feeder_uid =~ ^[1-9][0-9]*$ ]] || die "AVADO render requires a non-root audio feeder UID"
    else
        [[ -z $render_audio_feeder_uid ]] || die "ICP render does not accept an audio feeder UID"
    fi
else
    [[ -z $output_root && -z $render_state_device && -z $render_web_response_verify_sha256 && -z $render_audio_feeder_uid ]] \
        || die "render-only arguments require --render-only"
fi

[[ $appliance_id =~ ^[a-z0-9][a-z0-9._-]{0,63}$ ]] || die "invalid appliance identifier"
[[ $runtime_user =~ ^[a-z_][a-z0-9_-]{0,30}$ ]] || die "invalid runtime user"
for path in "$runtime_home" "$unit_source_root" "$user_unit_root" "$system_unit_root" "$rescue_system_unit_root" "$active_generation_root" "$management_marker" "$post_install_verifier" "$post_install_verifier_config" "$model_lock" "$maintenance_lease" "$authority_env" "$unit_policy" "$ollama_binary" "$state_store_helper" "$state_store_config" "$source_root" "$candidate_root" "$builder_root" "$updater_root" "$toolchain_root"; do
    [[ $path == /* && $path != / && $path != *'/../'* && $path != */.. && $path != *' '* ]] || die "unsafe absolute path: $path"
done
[[ $user_unit_root == "$runtime_home/.config/systemd/user" ]] || die "user unit root is not beneath the explicit runtime home"
[[ $system_unit_root == /etc/systemd/system ]] || die "system unit root must be /etc/systemd/system"
[[ $rescue_system_unit_root == "$updater_root/system-units" ]] \
    || die "rescue system-unit root must be the exact private updater alias"
[[ $management_marker == /etc/astrid/edge-service-manager.json ]] || die "management marker path is not the fixed operator contract"
[[ $authority_env == /etc/astrid/edge-self-change-authority.env ]] || die "self-change authority path is not the fixed root contract"
[[ $self_evolution_dropin_sha256 =~ ^[0-9a-f]{64}$ ]] || die "self-evolution drop-in SHA-256 is invalid"
[[ $ollama_binary_sha256 =~ ^[0-9a-f]{64}$ ]] || die "Ollama binary SHA-256 is invalid"
[[ $operator_report_manifest_sha256 =~ ^[0-9a-f]{64}$ ]] || die "operator report manifest SHA-256 is invalid"
[[ $provider_output_tokens =~ ^[0-9]+$ ]] && ((provider_output_tokens >= 64 && provider_output_tokens <= 512)) || die "provider output-token ceiling is invalid"
[[ $state_store_helper_sha256 =~ ^[0-9a-f]{64}$ ]] || die "state-store helper SHA-256 is invalid"
[[ $state_store_config == /etc/astrid/edge-state-store.json ]] || die "state-store config is not the immutable root contract"
[[ $state_store_runtime_mount_unit == *.mount && $state_store_rollback_mount_unit == *.mount && $state_store_runtime_mount_unit != "$state_store_rollback_mount_unit" ]] || die "state-store mount units are invalid"
[[ $state_store_verify_unit == astrid-edge-state-store-verify.service ]] || die "state-store verifier unit is invalid"
[[ $state_store_health_timer == astrid-edge-state-store-health.timer ]] || die "state-store health timer is invalid"
[[ ${active_generation_root##*/} == current ]] || die "active generation root must end in /current"
[[ -d $runtime_home && -d $unit_source_root && -d $user_unit_root ]] || die "runtime home, sources, and user-unit root must exist"
runtime_uid=$(id -u "$runtime_user" 2>/dev/null) || die "runtime user does not exist"
runtime_gid=$(id -g "$runtime_user" 2>/dev/null) || die "runtime group does not exist"
active_profile_env=${model_lock%/*}/active-profile.env
[[ $active_profile_env == /*/active-profile.env && $active_profile_env != *'/../'* && $active_profile_env != *' '* ]] \
    || die "active profile path is unsafe"
supervisor_state_root=${model_lock%/*}
release_parent=${active_generation_root%/*}
builder_image=${builder_root}.ext4
[[ ${maintenance_lease%/*} == "$supervisor_state_root" ]] \
    || die "maintenance lease and model lock must share the immutable supervisor root"
[[ $release_parent != / && ${active_generation_root##*/} == current ]] \
    || die "active generation root has no bounded release parent"
declare -a private_managed_roots=(
    "$supervisor_state_root" "$release_parent" "$source_root" "$candidate_root"
    "$builder_root" "$builder_image" "$updater_root" "$toolchain_root"
    /etc/astrid /etc/astrid-edge-self-change
    /usr/libexec/astrid /usr/libexec/astrid-edge/immutable
    /var/lib/astrid-edge-provider /var/lib/astrid-edge-web-core
    /var/lib/astrid-edge-web-runtime
    /var/lib/astrid-edge-web-steward /var/lib/astrid-edge-model-warmup
    /opt/astrid-edge-presentation
)
userctl() {
    runuser -u "$runtime_user" -- env XDG_RUNTIME_DIR="/run/user/$runtime_uid" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$runtime_uid/bus" systemctl --user "$@"
}
if $live_run; then
    [[ $(id -u) == 0 && $(uname -s) == Linux ]] || die "migration requires Linux root"
    for command_name in getent stat sha256sum awk find sort grep sed tr cp rm mkdir mktemp install systemctl systemd-analyze runuser findmnt readlink python3 sleep chattr lsattr; do
        command -v "$command_name" >/dev/null || die "required command absent: $command_name"
    done
    account_home=$(getent passwd "$runtime_user" | cut -d: -f6)
    [[ $account_home == "$runtime_home" ]] || die "runtime home does not match the account database"
    $start_services || die "live migration requires --start-services"
fi

readonly -a STACK=(
    ollama-cpu.service
    astrid-model-warmup.service
    astrid.service
    astrid-edge-runtime.service
    astrid-edge-hindsight.service
    astrid-edge-hindsight.timer
)
readonly MODEL_LOCK_GROUP=astrid-edge-model-lock
readonly REFLECTION_LEASE=/run/astrid-edge-self-change/reflection.json
readonly OLLAMA_RUNTIME_DIGEST=/etc/astrid/edge-ollama-runtime.sha256
readonly OPERATOR_REPORT_ROOT=/usr/libexec/astrid-edge/operator
readonly OPERATOR_REPORT_MANIFEST=/usr/libexec/astrid-edge/operator/MANIFEST.sha256
readonly HINDSIGHT_WRITER=/usr/libexec/astrid-edge/immutable/edge_hindsight.py
readonly HINDSIGHT_CONFIG=/etc/astrid-edge-self-change/hindsight-writer.json
readonly SCHEDULED_AUTHORSHIP_VERIFY_KEY=/etc/astrid/edge-scheduled-authorship.pub
readonly WEB_CORE_CLIENT_GROUP=astrid-edge-web-core-client
readonly WEB_CORE_CONFIG=/etc/astrid-edge-self-change/web-broker-core.json
readonly CORE_WEB_REQUEST_KEY=/etc/astrid-edge-self-change/core-web-request.key
readonly WEB_RESPONSE_VERIFY_KEY=/etc/astrid-edge-self-change/web-response.pub
readonly WEB_CORE_SOCKET_UNIT=astrid-edge-web-broker-core.socket
readonly WEB_CORE_SERVICE_UNIT=astrid-edge-web-broker-core.service
readonly WEB_CORE_SOCKET=/run/astrid-edge-self-change/web-core.sock
readonly AUDIO_CLIENT_GROUP=astrid-edge-audio-client
readonly AUDIO_FEEDER_UID_ENV=ASTRID_EDGE_AUDIO_FEEDER_UID
readonly ICP_SSD_GUARD=/usr/libexec/astrid-edge/immutable/wait-for-icp-ssd
scheduled_authorship_root=$candidate_root/scheduled-authorship
scheduled_authorship_verify_key_sha256=
scheduled_authorship_steward_uid=
contains() { local needle=$1 value; shift; for value in "$@"; do [[ $value == "$needle" ]] && return 0; done; return 1; }
((${#requested_units[@]} == ${#STACK[@]})) || die "the exact six-unit appliance stack is required"
((${#requested_hash_specs[@]} == ${#STACK[@]})) || die "every appliance unit requires an explicit SHA-256"
for unit in "${STACK[@]}"; do contains "$unit" "${requested_units[@]}" || die "required stack unit absent: $unit"; done
for unit in "${requested_units[@]}"; do contains "$unit" "${STACK[@]}" || die "unexpected stack unit: $unit"; done

source_profile=$unit_source_root
[[ $profile == icp ]] && source_profile=$unit_source_root/icp
hash_file() { sha256sum -- "$1" | awk '{print $1}'; }
operator_home_wrapper() {
    local target=$1
    case "$target" in
        "$OPERATOR_REPORT_ROOT/astrid-at-a-glance"|"$OPERATOR_REPORT_ROOT/astrid-train"|"$OPERATOR_REPORT_ROOT/report-edge-appliance"|"$OPERATOR_REPORT_ROOT/report-edge-activity") ;;
        *) die "operator home wrapper target is not allowlisted" ;;
    esac
    cat <<EOF
#!/bin/sh
exec $target "\$@"
EOF
}
stat_values() {
    if stat -c '%u %a %h' -- "$1" >/dev/null 2>&1; then stat -c '%u %a %h' -- "$1"; else stat -f '%u %Lp %l' -- "$1"; fi
}
if $live_run; then
    validate_root_regular "$active_profile_env" "active immutable profile"
    [[ $(stat_values "$active_profile_env") == '0 400 1' ]] \
        || die "active immutable profile ownership/mode/link count is invalid"
    [[ $completion_marker == /*/system-migration.complete && ! -e $completion_marker && ! -L $completion_marker ]] || die "completion marker must be an absent exact absolute path"
    marker_parent=${completion_marker%/*}
    IFS=' ' read -r marker_owner marker_mode marker_links < <(stat_values "$marker_parent")
    [[ -d $marker_parent && ! -L $marker_parent && $marker_owner == 0 && $marker_mode == 700 && $marker_links -ge 1 ]] || die "completion marker parent must be a private root-owned directory"
fi
validate_regular() {
    local path=$1 label=$2 owner mode links
    [[ -f $path && ! -L $path ]] || die "$label is not a regular non-symlink: $path"
    IFS=' ' read -r owner mode links < <(stat_values "$path")
    [[ $links == 1 ]] || die "$label is hard-linked: $path"
    (( (8#$mode & 8#022) == 0 )) || die "$label is group/world writable: $path"
}
validate_root_regular() {
    local path=$1 label=$2 owner mode links
    validate_regular "$path" "$label"
    IFS=' ' read -r owner mode links < <(stat_values "$path")
    [[ $owner == 0 && $links == 1 ]] || die "$label must be root-owned and single-linked: $path"
}
expected_profile_dropins=(astrid-local-ollama.conf)
[[ $profile == icp ]] && expected_profile_dropins=(icp-ssd-required.conf astrid-edge-tuning-authority.conf)
((${#profile_dropin_hash_specs[@]} == ${#expected_profile_dropins[@]})) || die "every profile drop-in requires an explicit SHA-256"
declare -a profile_dropin_hashes=()
for name in "${expected_profile_dropins[@]}"; do
    expected_hash=
    for spec in "${profile_dropin_hash_specs[@]}"; do
        [[ ${spec%%=*} == "$name" ]] || continue
        [[ -z $expected_hash ]] || die "duplicate profile drop-in SHA-256: $name"
        expected_hash=${spec#*=}
    done
    [[ $expected_hash =~ ^[0-9a-f]{64}$ ]] || die "missing or invalid profile drop-in SHA-256: $name"
    validate_later=$unit_source_root/$name
    [[ -f $validate_later && ! -L $validate_later ]] || die "profile drop-in source is absent: $name"
    [[ $(hash_file "$validate_later") == "$expected_hash" ]] || die "profile drop-in source digest mismatch: $name"
    profile_dropin_hashes+=("$expected_hash")
done
if $live_run; then
    [[ -L $active_generation_root ]] || die "active generation root must be the root-owned current symlink"
    active_generation_resolved=$(readlink -f -- "$active_generation_root") || die "cannot resolve active generation"
    [[ -d $active_generation_resolved && ! -L $active_generation_resolved ]] || die "active generation target is absent"
    IFS=' ' read -r generation_owner generation_mode generation_links < <(stat_values "$active_generation_resolved")
    [[ $generation_owner == 0 ]] && (( (8#$generation_mode & 8#022) == 0 )) || die "active generation target is not root-owned immutable content"
    for relative in astrid-daemon astrid-edge-runtime scripts/warm_ollama_model.sh scripts/edge_hindsight.py; do
        validate_root_regular "$active_generation_root/$relative" "active generation executable"
        [[ -x $active_generation_root/$relative ]] || die "active generation executable lacks execute permission: $relative"
    done
    [[ -d $active_generation_root/installed-capsules && ! -L $active_generation_root/installed-capsules ]] || die "active generation has no immutable installed capsule tree"
    validate_root_regular "$post_install_verifier" "post-install verifier"
    [[ -x $post_install_verifier ]] || die "post-install verifier is not executable"
    validate_root_regular "$post_install_verifier_config" "post-install verifier config"
    validate_root_regular "$HINDSIGHT_WRITER" "immutable hindsight writer"
    [[ $(stat_values "$HINDSIGHT_WRITER" | awk '{print $2}') == 444 ]] \
        || die "immutable hindsight writer must have exact mode 0444"
    validate_root_regular "$HINDSIGHT_CONFIG" "immutable hindsight writer config"
    IFS=' ' read -r hindsight_config_owner hindsight_config_mode hindsight_config_links < <(stat_values "$HINDSIGHT_CONFIG")
    [[ $hindsight_config_owner == 0 && $hindsight_config_mode == 440 && $hindsight_config_links == 1 ]] \
        || die "immutable hindsight writer config must be root-owned mode 0440"
    [[ $(stat -c '%g' -- "$HINDSIGHT_CONFIG") == "$runtime_gid" ]] \
        || die "immutable hindsight writer config is not bound to the runtime group"
    scheduled_authorship_steward_uid=$(id -u astrid-edge-steward 2>/dev/null) \
        || die "scheduled-authorship steward identity is absent"
    scheduled_authorship_steward_gid=$(id -g astrid-edge-steward 2>/dev/null) \
        || die "scheduled-authorship steward group is absent"
    IFS=' ' read -r authorship_owner authorship_mode authorship_links < <(stat_values "$scheduled_authorship_root")
    [[ -d $scheduled_authorship_root && ! -L $scheduled_authorship_root \
        && $authorship_owner == "$scheduled_authorship_steward_uid" \
        && $authorship_mode == 750 && $authorship_links -ge 1 \
        && $(stat -c '%g' -- "$scheduled_authorship_root") == "$runtime_gid" ]] \
        || die "scheduled-authorship root is not steward:runtime mode 0750"
    [[ $scheduled_authorship_steward_gid != "$runtime_gid" ]] \
        || die "scheduled-authorship steward and runtime groups must remain distinct"
    validate_root_regular "$SCHEDULED_AUTHORSHIP_VERIFY_KEY" "scheduled-authorship public key"
    [[ $(stat_values "$SCHEDULED_AUTHORSHIP_VERIFY_KEY" | awk '{print $2}') == 440 \
        && $(stat -c '%g' -- "$SCHEDULED_AUTHORSHIP_VERIFY_KEY") == "$runtime_gid" \
        && $(wc -c <"$SCHEDULED_AUTHORSHIP_VERIFY_KEY" | tr -d ' ') == 32 ]] \
        || die "scheduled-authorship public key identity is invalid"
    scheduled_authorship_verify_key_sha256=$(hash_file "$SCHEDULED_AUTHORSHIP_VERIFY_KEY")
    web_core_client_gid=$(getent group "$WEB_CORE_CLIENT_GROUP" | cut -d: -f3)
    [[ $web_core_client_gid =~ ^[1-9][0-9]*$ ]] || die "core web-broker client group is absent"
    [[ -z $(getent group "$WEB_CORE_CLIENT_GROUP" | cut -d: -f4) ]] \
        || die "core web-broker authority leaked into persistent account membership"
    validate_root_regular "$WEB_CORE_CONFIG" "immutable core web-broker config"
    IFS=' ' read -r core_web_config_owner core_web_config_mode core_web_config_links < <(stat_values "$WEB_CORE_CONFIG")
    [[ $core_web_config_owner == 0 && $core_web_config_mode == 440 && $core_web_config_links == 1 ]] \
        || die "immutable core web-broker config must be root-owned single-link mode 0440"
    validate_root_regular "$CORE_WEB_REQUEST_KEY" "immutable core web-broker request key"
    [[ $(stat_values "$CORE_WEB_REQUEST_KEY" | awk '{print $2}') == 400 \
        && $(wc -c <"$CORE_WEB_REQUEST_KEY" | tr -d ' ') == 32 ]] \
        || die "immutable core web-broker request key identity is invalid"
    validate_root_regular "$WEB_RESPONSE_VERIFY_KEY" "immutable web-broker response public key"
    [[ $(stat_values "$WEB_RESPONSE_VERIFY_KEY" | awk '{print $2}') == 644 \
