import json, os, pathlib, stat, sys, tempfile

path = pathlib.Path(sys.argv[1])
expected = int(sys.argv[2])
uid = int(sys.argv[3])
gid = int(sys.argv[4])
before = path.lstat()
if not stat.S_ISREG(before.st_mode) or stat.S_ISLNK(before.st_mode) or before.st_uid != uid or before.st_gid != gid or before.st_nlink != 1 or stat.S_IMODE(before.st_mode) != 0o600:
