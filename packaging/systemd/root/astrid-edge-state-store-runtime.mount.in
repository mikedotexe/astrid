[Unit]
# The installer must render this template to the exact filename returned by
# `astrid-edge-state-store unit-names` for the runtime mount.
Description=Astrid CPU-edge bounded runtime-state filesystem
Documentation=file:@@ACTIVE_GENERATION_ROOT@@/docs/cpu-edge-self-evolution.md
RequiresMountsFor=@@RUNTIME_IMAGE_PARENT@@
Requires=astrid-edge-state-store-migration-recover.service
After=astrid-edge-state-store-migration-recover.service
Before=astrid-edge-state-store-recover.service astrid-edge-state-store-verify.service

[Mount]
What=@@RUNTIME_IMAGE@@
Where=@@RUNTIME_STATE_ROOT@@
Type=ext4
Options=loop,rw,nodev,nosuid,noexec,noatime
TimeoutSec=90

[Install]
WantedBy=multi-user.target
