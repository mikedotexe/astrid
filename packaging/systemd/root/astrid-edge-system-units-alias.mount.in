[Unit]
Description=Astrid CPU-edge private system-unit activation alias
Documentation=https://github.com/mikedotexe/astrid
RequiresMountsFor=@@UPDATER_ROOT@@
Before=astrid-edge-generation-guard.service astrid-edge-self-change-supervisor.service astrid-edge-self-change-probation-health.service

[Mount]
What=/etc/systemd/system
Where=@@SYSTEM_UNIT_ALIAS@@
Type=none
Options=bind,nosuid,nodev,noexec

[Install]
WantedBy=multi-user.target
