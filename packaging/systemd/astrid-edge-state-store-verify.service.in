[Unit]
Description=Verify bounded Astrid CPU-edge runtime and rollback filesystems
Documentation=file:@@ACTIVE_GENERATION_ROOT@@/docs/cpu-edge-self-evolution.md
Requires=@@RUNTIME_MOUNT_UNIT@@ @@ROLLBACK_MOUNT_UNIT@@ astrid-edge-state-store-recover.service
After=@@RUNTIME_MOUNT_UNIT@@ @@ROLLBACK_MOUNT_UNIT@@ astrid-edge-state-store-recover.service
Before=astrid-edge-builder-store-verify.service astrid-edge-generation-guard.service
Before=astrid-edge-self-change-supervisor.service astrid-edge-steward.service
Before=astrid.service astrid-edge-runtime.service astrid-edge-hindsight.service

[Service]
Type=oneshot
User=root
Group=root
ExecStartPre=/usr/bin/test -s /etc/astrid/edge-state-store.json
ExecStartPre=/usr/bin/test -x /usr/libexec/astrid/astrid-edge-state-store
ExecStartPre=/usr/bin/python3 -I -E -s /usr/libexec/astrid/astrid-edge-state-store prepare --config /etc/astrid/edge-state-store.json
ExecStart=/usr/bin/python3 -I -E -s /usr/libexec/astrid/astrid-edge-state-store attest --config /etc/astrid/edge-state-store.json --full-inventory --output /run/astrid-edge-state-store/install-attestation.json
ExecStart=/usr/bin/python3 -I -E -s /usr/libexec/astrid/astrid-edge-state-store attest --config /etc/astrid/edge-state-store.json --output /run/astrid-edge-state-store/health-attestation.json
RemainAfterExit=yes
UMask=0077
RuntimeDirectory=astrid-edge-state-store
RuntimeDirectoryMode=0700
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
AmbientCapabilities=
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/astrid/edge-state-store.json @@RUNTIME_IMAGE@@ @@ROLLBACK_IMAGE@@ @@MIGRATION_ROOT@@
ReadWritePaths=@@RUNTIME_STATE_ROOT@@ @@ROLLBACK_STATE_ROOT@@
ReadWritePaths=/run/astrid-edge-state-store
NoExecPaths=/
ExecPaths=/usr/bin/python3 /usr/bin/findmnt /usr/sbin/blkid /usr/sbin/dumpe2fs /usr/sbin/losetup /usr/libexec/astrid/astrid-edge-state-store /usr/lib /usr/lib64 /lib /lib64
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service
SystemCallFilter=~@clock @debug @module @mount @obsolete @privileged @raw-io @reboot @swap

[Install]
WantedBy=multi-user.target
