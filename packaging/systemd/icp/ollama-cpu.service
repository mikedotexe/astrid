[Unit]
Description=ICP Astrid local CPU model service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=%h/.astrid-icp/ollama/models
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_KEEP_ALIVE=2h
Environment=OLLAMA_CONTEXT_LENGTH=2048
Environment=OLLAMA_LLM_LIBRARY=sse42
ExecStart=%h/.astrid-icp/ollama/runtime/bin/ollama serve
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077
LimitNOFILE=65536
TasksMax=512

[Install]
WantedBy=default.target
