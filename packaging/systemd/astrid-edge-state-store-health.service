[Unit]
Description=Refresh Astrid CPU-edge bounded-storage health attestation
Requires=astrid-edge-state-store-verify.service
After=astrid-edge-state-store-verify.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -I -E -s /usr/libexec/astrid/astrid-edge-state-store attest --config /etc/astrid/edge-state-store.json --output /run/astrid-edge-state-store/health-attestation.json
UMask=0077
CapabilityBoundingSet=CAP_DAC_OVERRIDE
AmbientCapabilities=
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/astrid/edge-state-store.json
ReadWritePaths=/run/astrid-edge-state-store
NoExecPaths=/
ExecPaths=/usr/bin/python3 /usr/bin/findmnt /usr/sbin/blkid /usr/sbin/dumpe2fs /usr/sbin/losetup /usr/libexec/astrid/astrid-edge-state-store /usr/lib /usr/lib64 /lib /lib64
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service
SystemCallFilter=~@clock @debug @module @mount @obsolete @privileged @raw-io @reboot @swap
