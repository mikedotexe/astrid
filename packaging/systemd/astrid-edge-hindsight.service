[Unit]
Description=Checkpoint Astrid edge activity for owner-only hindsight
Documentation=https://github.com/mikedotexe/astrid
After=astrid-edge-runtime.service
ConditionPathIsDirectory=%h/.astrid/home/default/edge

[Service]
Type=oneshot
WorkingDirectory=%h
ExecStart=%h/.astrid/bin/edge-hindsight record --workspace %h/.astrid/home/default/edge --state-root %h/.astrid
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.astrid/operator/hindsight

[Install]
WantedBy=default.target
