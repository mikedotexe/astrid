[Unit]
Description=Load Astrid's selected local CPU model
Documentation=https://docs.ollama.com/api
Requires=ollama-cpu.service
After=ollama-cpu.service
Before=astrid.service astrid-edge-runtime.service
ConditionPathExists=%h/.config/astrid/edge-appliance.env

[Service]
Type=oneshot
WorkingDirectory=%h
EnvironmentFile=%h/.config/astrid/edge-appliance.env
ExecStart=%h/.astrid/bin/warm-ollama-model
RemainAfterExit=yes
# The immutable provider gateway owns the 660-second request deadline.  Keep a
# full minute outside that deadline so systemd can collect the terminal receipt
# and run cleanup rather than killing the client at the same boundary.
TimeoutStartSec=12min
UMask=0077

[Install]
WantedBy=default.target
