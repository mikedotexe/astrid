[Unit]
Description=Astrid CPU-edge steward-scoped bounded web broker
Documentation=https://github.com/mikedotexe/astrid
Requires=astrid-edge-web-broker-steward.socket
After=astrid-edge-web-broker-steward.socket network-online.target
Wants=network-online.target

[Service]
Type=simple
User=astrid-edge-web
Group=astrid-edge-web
Sockets=astrid-edge-web-broker-steward.socket
StandardInput=socket
StandardOutput=journal
StandardError=journal
LoadCredential=request.key:/etc/astrid-edge-self-change/steward-web-request.key
LoadCredential=response-signing.key:/etc/astrid-edge-self-change/web-response-signing.key
ExecStart=/usr/libexec/astrid-edge/immutable/astrid-edge-web-broker --config /etc/astrid-edge-self-change/web-broker-steward.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
KillMode=mixed
UMask=0077
StateDirectory=astrid-edge-web-steward
StateDirectoryMode=0700
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service
SystemCallFilter=~@clock @debug @module @mount @obsolete @privileged @raw-io @reboot @swap
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=0.0.0.0/8
IPAddressDeny=10.0.0.0/8
IPAddressDeny=100.64.0.0/10
IPAddressDeny=127.0.0.0/8
IPAddressDeny=169.254.0.0/16
IPAddressDeny=172.16.0.0/12
IPAddressDeny=192.168.0.0/16
IPAddressDeny=224.0.0.0/3
IPAddressDeny=::/128
IPAddressDeny=::1/128
IPAddressDeny=fc00::/7
IPAddressDeny=fe80::/10
IPAddressDeny=ff00::/8
ReadOnlyPaths=/etc/astrid-edge-self-change/web-broker-steward.json
InaccessiblePaths=/var/lib/astrid-edge-web-core /var/lib/astrid-edge-web-runtime
NoExecPaths=/
ExecPaths=/usr/libexec/astrid-edge/immutable/astrid-edge-web-broker /usr/lib /lib /lib64
TasksMax=32
MemoryHigh=100663296
MemoryMax=134217728
MemorySwapMax=0
CPUQuota=50%
IOWeight=10
