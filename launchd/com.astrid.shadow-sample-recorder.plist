<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.astrid.shadow-sample-recorder</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/v/other/astrid/scripts/shadow_sample_recorder.py</string>
    </array>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>WorkingDirectory</key>
    <string>/Users/v/other/astrid</string>
    <key>StandardOutPath</key>
    <string>/Users/v/other/astrid/capsules/spectral-bridge/workspace/logs/shadow_sample_recorder.launchd.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/v/other/astrid/capsules/spectral-bridge/workspace/logs/shadow_sample_recorder.launchd.err</string>
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
